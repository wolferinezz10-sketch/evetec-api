# EVETEC Mercado Pago Server
PORT=3000
PUBLIC_BASE_URL=https://tu-dominio-publico.example

# Credencial productiva de la cuenta EVETEC (fallback).
MERCADO_PAGO_ACCESS_TOKEN=APP_USR_REEMPLAZAR

# Aplicacion Marketplace/OAuth para vincular cuentas de terceros.
MP_CLIENT_ID=REEMPLAZAR
MP_CLIENT_SECRET=REEMPLAZAR
COMISION_EVETEC=15

# Obligatorio para que solo el administrador acceda a /admin.
ADMIN_PASSWORD=GENERAR_UNA_CLAVE_LARGA_Y_UNICA

# Recomendado. Debe coincidir con DEVICE_API_KEY en el firmware.
DEVICE_API_KEY=GENERAR_OTRA_CLAVE_LARGA_Y_UNICA

# En produccion usar almacenamiento persistente o una base de datos.
DATA_FILE=evetec-timers-data.json
